# Copy to .env for local use. Never commit real values.
APP_ENV=local
# Gemini model used for chat. Change here (or in Railway variables) without a code release.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Postgres connection string (Railway provides DATABASE_URL).
DATABASE_URL=
# Optional: folder with Swiss Ephemeris .se1 files. Empty = built-in Moshier mode.
EPHEMERIS_PATH=
