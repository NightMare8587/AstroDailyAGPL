# Copy to .env for local use. Never commit real values.
APP_ENV=local
# Gemini model used for chat. Change here (or in Railway variables) without a code release.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Postgres connection string (Railway provides DATABASE_URL).
DATABASE_URL=
# Google Sign-In: comma-separated OAuth client IDs (web, Android, iOS) accepted as token audience.
GOOGLE_CLIENT_IDS=
# Secret used to sign access tokens. Required when APP_ENV is not "local". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60
# Optional: folder with Swiss Ephemeris .se1 files. Empty = built-in Moshier mode.
EPHEMERIS_PATH=
# Rate limits, requests per minute per client IP. Set RATE_LIMIT_ENABLED=false to turn off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PANCHANG_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Header with the real client IP set by the platform proxy. Empty = x-real-ip in production, none locally.
CLIENT_IP_HEADER=

# Content library: show draft (unreviewed) wording on cards. Keep false in production until reviewed.
CONTENT_ALLOW_DRAFT=false

# Push notifications (Firebase Cloud Messaging): the service-account JSON as one line. Without it the
# dispatcher only logs what it would send.
FCM_SERVICE_ACCOUNT_JSON=
NOTIFY_MAX_LATE_MINUTES=180
