# Copy to .env for local use. Never commit real values.
APP_ENV=local
# Gemini model used for chat. Change here (or in Railway variables) without a code release.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Postgres connection string (Railway provides DATABASE_URL).
DATABASE_URL=
# Google Sign-In: comma-separated OAuth client IDs (web, Android, iOS) accepted as token audience.
GOOGLE_CLIENT_IDS=
# Secret used to sign access tokens. Required when APP_ENV is not "local". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60
# Optional: folder with Swiss Ephemeris .se1 files. Empty = built-in Moshier mode.
EPHEMERIS_PATH=
